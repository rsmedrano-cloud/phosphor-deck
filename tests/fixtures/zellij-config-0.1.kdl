// ── PHOSPHOR DECK ─────────────────────────────────────────
// Installed by `phosphor gen` when you had no config.kdl of your own.
// The theme lives in themes/phosphor.kdl: gen writes it from `theme`
// in the profile (p31 green, p3 amber, p4 white, paper).

theme "phosphor"
default_layout "deck"
pane_frames true
session_serialization true
mouse_mode true

ui {
    pane_frames {
        rounded_corners false
    }
}

// ── LOCKED MODE ───────────────────────────────────────────
// matterhorn collides with zellij on 10 Ctrl keys (b c f g n o p q s t)
// and uses 12 Alt keys; no one-off remap fixes that. In locked mode zellij
// intercepts NOTHING: every key goes straight to the tool inside. Only the
// bindings below stay live, picked among keys matterhorn doesn't use.
default_mode "locked"

keybinds {
    // ONE key takes and gives back zellij's controls: Alt-g. Ctrl-g is off
    // in every mode: it's matterhorn's jump-to-channel.
    unbind "Ctrl g"

    locked clear-defaults=true {
        bind "Alt g" { SwitchToMode "Normal"; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Alt Left"  { MoveFocus "Left"; }
        bind "Alt Right" { MoveFocus "Right"; }
        bind "Alt Up"    { MoveFocus "Up"; }
        bind "Alt Down"  { MoveFocus "Down"; }
        // zoom: the focused pane takes the whole tab (made for phones)
        bind "Alt z" { ToggleFocusFullscreen; }
        bind "Alt x" { Detach; }
        // Ctrl-q is what people press to leave: it detaches, never kills the deck
        bind "Ctrl q" { Detach; }
    }

    shared_except "locked" {
        bind "Alt g" { SwitchToMode "Locked"; }
        // Alt-f shows/hides floating panes: the path that wedged zellij 0.45
        // in this deck. Off until it's reproduced in isolation.
        unbind "Alt f"
        bind "Ctrl q" { Detach; }
    }
}
