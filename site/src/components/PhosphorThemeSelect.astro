---
// Replaces Starlight's own light/dark/auto ThemeSelect: this site doesn't
// have a light and a dark mode, it has Phosphor's four screen colors (the
// same [deck] theme setting in the profile) -- p31 green, p3 amber, p4
// white, paper e-ink. See src/styles/phosphor.css for the palettes and
// astro.config.mjs's `head` for the inline script that applies the saved
// choice before first paint (no flash of the wrong color).
import Select from '@astrojs/starlight/components/Select.astro';

const options = [
	{ label: 'p31 -- green', value: 'p31', selected: true },
	{ label: 'p3 -- amber', value: 'p3', selected: false },
	{ label: 'p4 -- white', value: 'p4', selected: false },
	{ label: 'paper', value: 'paper', selected: false },
];
---

<phosphor-theme-select>
	<Select icon="setting" label="Select screen color" options={options} width="6.5em" />
</phosphor-theme-select>

<script>
	type PhosphorTheme = 'p31' | 'p3' | 'p4' | 'paper';
	const THEMES: PhosphorTheme[] = ['p31', 'p3', 'p4', 'paper'];
	const STORAGE_KEY = 'phosphor-theme';

	const parse = (v: unknown): PhosphorTheme =>
		THEMES.includes(v as PhosphorTheme) ? (v as PhosphorTheme) : 'p31';

	function apply(theme: PhosphorTheme) {
		document.documentElement.dataset.phosphorTheme = theme;
		localStorage.setItem(STORAGE_KEY, theme);
		document.querySelectorAll('phosphor-theme-select select').forEach((el) => {
			if (el instanceof HTMLSelectElement) el.value = theme;
		});
	}

	class PhosphorThemeSelect extends HTMLElement {
		constructor() {
			super();
			this.querySelector('select')?.addEventListener('change', (e) => {
				if (e.currentTarget instanceof HTMLSelectElement) apply(parse(e.currentTarget.value));
			});
		}
	}
	customElements.define('phosphor-theme-select', PhosphorThemeSelect);
</script>
